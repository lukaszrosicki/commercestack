---
// src/components/ToolCard.astro
// Ścisła kontrola typów wejściowych dla komponentu karty narzędzia
interface Props {
  title: string;
  category: string;
  slug: string;
}

const { title, category, slug } = Astro.props;

// Zabezpieczenie ścieżki bazowej dla routingu dynamicznego
const base = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;
---

<div class="border border-slate-200 dark:border-slate-800 p-6 rounded-2xl bg-white dark:bg-slate-900 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between h-full group">
  <div>
    {/* Górny pasek: Kategoria jako Badge */}
    <div class="mb-4">
      <span class="inline-block text-xs font-semibold tracking-wider uppercase bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 px-2.5 py-1 rounded-md transition-colors">
        {category}
      </span>
    </div>
    
    {/* Nagłówek narzędzia */}
    <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-orange-500 dark:group-hover:text-orange-500 transition-colors mb-2">
      {title}
    </h3>
    
    <p class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2">
      Uruchom wyspecjalizowany moduł i przejdź do panelu obliczeniowego.
    </p>
  </div>

  {/* Przycisk akcji */}
  <div class="mt-6">
    <a 
      href={`${base}narzedzia/${slug}`} 
      class="inline-flex w-full items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-950 dark:hover:bg-slate-200 transition-all text-center"
    >
      Uruchom narzędzie
    </a>
  </div>
</div>
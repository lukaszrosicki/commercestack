---
// Integracja warstwy wizualnej stany surowego CStack z obsługą BASE_URL i Dark Mode

// Zabezpieczenie ścieżek bazowych dla GitHub Pages / podkatalogów
const base = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

// Definicja interfejsu danych dla menu stopki
interface FooterItem {
  label: string;
  href: string;
}

// Spójna definicja linków (Single Source of Truth, zsynchronizowana z Navbar)
const footerItems: FooterItem[] = [
  { label: 'Narzędzia', href: `${base}narzedzia` },
  { label: 'O projekcie', href: `${base}o-projekcie` },
  { label: 'Kontakt', href: `${base}kontakt` },
];
---

<footer class="w-full border-t border-slate-200 bg-white/80 backdrop-blur-md dark:border-slate-800 dark:bg-slate-950/80 transition-colors duration-200 py-6 mt-auto">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row h-auto sm:h-16 items-center justify-between gap-4 sm:gap-0">
      
      {/* Sekcja Lewa: Branding & Nawigacja Stopki */}
      <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-10 w-full sm:w-auto text-center sm:text-left">
        <div class="flex items-center">
          <a href={base} class="text-xl font-bold tracking-tight text-slate-900 dark:text-white transition-colors hover:text-slate-700 dark:hover:text-slate-300">
             &lt;Commerce<span class="text-orange-500">Stack</span>&gt;
          </a>
        </div>
        
        <nav class="flex items-center gap-6 text-sm font-medium">
          {footerItems.map(item => (
            <a 
              href={item.href} 
              class="text-slate-600 hover:text-orange-500 dark:text-slate-400 dark:hover:text-orange-500 transition-colors"
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>

      {/* Sekcja Prawa: Prawa autorskie i integracja GitHub */}
      <div class="flex items-center gap-6 text-xs text-slate-500 dark:text-slate-400">
        <div>
          &copy; {new Date().getFullYear()} dr Łukasz Rosicki.
        </div>
        <a 
          href="https://github.com/lukaszrosicki" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-1.5 hover:text-orange-500 transition-colors"
          aria-label="GitHub Repository"
        >
          {/* Natywna ikona GitHub inline SVG */}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"/>
          </svg>
          <span class="hidden sm:inline">Source</span>
        </a>
      </div>

    </div>
  </div>
</footer>
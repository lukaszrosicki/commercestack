---
// src/components/dynamic/break-even-roas.astro
// Kalkulator Break-Even ROAS – wyznacza minimalny poziom ROAS wymagany do pokrycia kosztów produktów (COGS) i marży operacyjnej
---

<div class="border border-slate-200 dark:border-slate-800 rounded-2xl bg-white dark:bg-slate-900 shadow-sm overflow-hidden transition-colors duration-200">
  
  {/* Nagłówek kalkulatora (Górna belka systemowa) */}
  <div class="bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 px-6 py-4 flex items-center justify-between transition-colors">
    <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Moduł Obliczeniowy</span>
    
    <div class="flex gap-1.5">
      <div class="w-3 h-3 rounded-full bg-slate-200 dark:bg-slate-800"></div>
      <div class="w-3 h-3 rounded-full bg-slate-200 dark:bg-slate-800"></div>
      <div class="w-3 h-3 rounded-full bg-slate-200 dark:bg-slate-800"></div>
    </div>
  </div>

  {/* Główny Kontener Grid: Formularz (Lewo) + Wyniki (Prawo) */}
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 p-6 md:p-8">
    
    {/* Kolumna Lewa: Pola wejściowe */}
    <div class="lg:col-span-7 flex flex-col gap-6 pr-0 lg:pr-4">
      
      <div class="border-b border-slate-100 dark:border-slate-800 pb-3 transition-colors">
        <h3 class="text-base font-bold text-slate-900 dark:text-white">Dane wejściowe</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Wprowadź strukturę marżową lub kosztową asortymentu w kampanii.</p>
      </div>

      {/* Toggles: Metoda definiowania kosztu (Marża vs COGS %) */}
      <div>
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Metoda określania kosztów produktu</label>
        <div class="flex bg-slate-100 dark:bg-slate-950 p-1 rounded-xl border border-slate-200/60 dark:border-slate-800/80 transition-colors">
          <label class="flex-1 text-center cursor-pointer">
            <input type="radio" name="be-roas-mode" value="margin" class="peer hidden" checked />
            <div class="py-2.5 text-sm font-semibold text-slate-500 dark:text-slate-400 rounded-lg peer-checked:bg-white dark:peer-checked:bg-slate-900 peer-checked:text-slate-900 dark:peer-checked:text-white peer-checked:shadow-sm transition-all">
              Marża brutto sklepu (%)
            </div>
          </label>
          <label class="flex-1 text-center cursor-pointer">
            <input type="radio" name="be-roas-mode" value="cogs" class="peer hidden" />
            <div class="py-2.5 text-sm font-semibold text-slate-500 dark:text-slate-400 rounded-lg peer-checked:bg-white dark:peer-checked:bg-slate-900 peer-checked:text-slate-900 dark:peer-checked:text-white peer-checked:shadow-sm transition-all">
              Udział kosztu towaru / COGS (%)
            </div>
          </label>
        </div>
      </div>

      {/* Input: Wartość procentowa (Marża lub COGS) */}
      <div>
        <label for="be-roas-percentage" id="be-roas-percentage-label" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
          Średnia marża brutto na produktach (%)
        </label>
        <div class="flex items-stretch bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl focus-within:ring-2 focus-within:ring-orange-500 focus-within:border-orange-500 transition-all overflow-hidden">
          <div class="flex items-center justify-center bg-slate-50 dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 px-4 text-slate-400 dark:text-slate-500 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
              <path fill-rule="evenodd" d="M11.5 2a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M9.05 3a2.5 2.5 0 0 1 4.9 0H16a.5.5 0 0 1 0 1h-2.05a2.5 2.5 0 0 1-4.9 0H0a.5.5 0 0 1 0-1zM4.5 7a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M2.05 8a2.5 2.5 0 0 1 4.9 0H16a.5.5 0 0 1 0 1H6.95a2.5 2.5 0 0 1-4.9 0H0a.5.5 0 0 1 0-1zm9.5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3m-2.45 1a2.5 2.5 0 0 1 4.9 0H16a.5.5 0 0 1 0 1h-2.05a2.5 2.5 0 0 1-4.9 0H0a.5.5 0 0 1 0-1z"/>
            </svg>
          </div>
          <input 
            type="number" 
            id="be-roas-percentage" 
            placeholder="np. 40" 
            min="0.1" 
            max="99.9"
            step="0.1"
            class="w-full px-4 py-3 bg-transparent outline-none placeholder-slate-400 text-slate-900 dark:text-white text-sm" 
          />
        </div>
      </div>

      {/* Input: Dodatkowe koszty obsługi zamówienia (opcjonalnie) */}
      <div>
        <label for="be-roas-fees" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
          Inne koszty zmienne np. prowizje płatności, pakowanie (%) <span class="text-xs font-normal text-slate-400 dark:text-slate-500">(opcjonalnie)</span>
        </label>
        <div class="group flex items-stretch bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl focus-within:ring-2 focus-within:ring-orange-500 focus-within:border-orange-500 transition-all overflow-hidden">
          <div class="flex items-center justify-center bg-slate-50 dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 px-4 text-slate-400 dark:text-slate-500 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
              <path d="M0 4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V6a2 2 0 0 1-2-2z"/>
            </svg>
          </div>
          <input 
            type="number" 
            id="be-roas-fees" 
            placeholder="np. 3" 
            min="0" 
            max="50"
            step="0.1"
            class="w-full px-4 py-3 bg-transparent outline-none placeholder-slate-400 text-slate-900 dark:text-white text-sm" 
          />
        </div>
      </div>

    </div>

    {/* Kolumna Prawa: Warstwa prezentacji wyników (Dashboard) */}
    <div class="lg:col-span-5 bg-slate-50 dark:bg-slate-900/60 rounded-xl p-6 sm:p-8 flex flex-col justify-center gap-6 border border-slate-200 dark:border-slate-800/80 transition-colors">
      
      <div>
        <p class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1">Próg rentowności (Break-Even ROAS)</p>
        <p class="text-4xl font-extrabold text-orange-500 tracking-tight transition-colors" id="be-roas-result">0.00</p>
      </div>
      
      <div>
        <p class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1">Maksymalny dopuszczalny CPA / CAC</p>
        <p class="text-2xl font-extrabold text-slate-800 dark:text-slate-200 transition-colors" id="be-roas-max-cpa">0,00% wartości koszyka</p>
      </div>
      
      <div class="grid grid-cols-1 gap-4 pt-6 border-t border-slate-200 dark:border-slate-800 transition-colors">
        <div>
          <p class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1">Ekwiwalent zapisu (skala marketingowa)</p>
          <p class="text-base font-medium text-slate-600 dark:text-slate-400 transition-colors" id="be-roas-ratio-text">Wymagany obrót: 0,00 PLN z każdej wydanej 1 PLN</p>
        </div>
      </div>
      
    </div>
    
  </div>
</div>

<script>
  // Logika obliczeniowa z pełnym wsparciem dla View Transitions (island logic)
  const initBreakEvenRoasCalculator = () => {
    const percentageInput = document.getElementById('be-roas-percentage') as HTMLInputElement | null;
    const feesInput = document.getElementById('be-roas-fees') as HTMLInputElement | null;
    const modeRadios = document.querySelectorAll('input[name="be-roas-mode"]') as NodeListOf<HTMLInputElement>;
    const percentageLabel = document.getElementById('be-roas-percentage-label') as HTMLLabelElement | null;

    const outBeRoas = document.getElementById('be-roas-result');
    const outMaxCpa = document.getElementById('be-roas-max-cpa');
    const outRatioText = document.getElementById('be-roas-ratio-text');

    const runCalculation = () => {
      if (!percentageInput || !feesInput) return;

      const inputPercent = parseFloat(percentageInput.value) || 0;
      const additionalFees = parseFloat(feesInput.value) || 0;
      
      const activeMode = (document.querySelector('input[name="be-roas-mode"]:checked') as HTMLInputElement | null)?.value || 'margin';

      // 1. Sprowadzenie do jednolitej wartości marży produktowej netto (Product Margin)
      // Jeśli użytkownik podaje COGS %, to Marża = 100% - COGS%
      let productMargin = activeMode === 'margin' ? inputPercent : (100 - inputPercent);

      // 2. Uwzględnienie dodatkowych kosztów operacyjnych na zamówienie
      let netContributionMargin = (productMargin - additionalFees) / 100;

      // Zabezpieczenie przed ujemną lub zerową marżą wkładu (kampania nigdy nie zarobi)
      if (netContributionMargin <= 0) {
        if (outBeRoas) outBeRoas.textContent = "∞";
        if (outMaxCpa) outMaxCpa.textContent = "Niewykonalne (koszty > 100%)";
        if (outRatioText) outRatioText.textContent = "Koszty stałe/zmienne przekraczają wartość produktów.";
        return;
      }

      // Ekonomiczny wzór na Break-Even ROAS:
      // BEP ROAS = 1 / Marża Kontrybucyjna
      const breakEvenRoas = 1 / netContributionMargin;

      // Maksymalny dopuszczalny koszt pozyskania (CPA jako % wartości koszyka)
      const maxCpaPercent = netContributionMargin * 100;

      // 3. Renderowanie wyników w DOM
      if (outBeRoas) {
        outBeRoas.textContent = breakEvenRoas.toFixed(2);
      }

      if (outMaxCpa) {
        outMaxCpa.textContent = `${maxCpaPercent.toFixed(1)}% wartości koszyka`;
      }

      if (outRatioText) {
        outRatioText.textContent = `Wymagany obrót: ${breakEvenRoas.toFixed(2)} PLN z każdej wydanej 1,00 PLN`;
      }
    };

    const updateLabels = () => {
      const activeMode = (document.querySelector('input[name="be-roas-mode"]:checked') as HTMLInputElement | null)?.value;

      if (percentageLabel && activeMode) {
        percentageLabel.textContent = activeMode === 'margin' 
          ? 'Średnia marża brutto na produktach (%)' 
          : 'Udział kosztu towaru / COGS (%)';
      }
      runCalculation();
    };

    // Rejestracja słuchaczy zdarzeń
    percentageInput?.addEventListener('input', runCalculation);
    feesInput?.addEventListener('input', runCalculation);
    modeRadios.forEach(radio => radio.addEventListener('change', updateLabels));
  };

  // Cykl inicjalizacji odporny na odświeżenia stanów SPA i ładowanie tradycyjne
  initBreakEvenRoasCalculator();
  document.addEventListener('astro:after-swap', initBreakEvenRoasCalculator);
</script>
---
// src/components/dynamic/bep.astro
// Integracja warstwy wizualnej kalkulatora BEP ze wsparciem Dark Mode i optymalizacją inline SVG
---

<div class="border border-slate-200 dark:border-slate-800 rounded-2xl bg-white dark:bg-slate-900 shadow-sm overflow-hidden transition-colors duration-200">

  {/* Nagłówek kalkulatora (Górna belka systemowa) */}
  <div class="bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 px-6 py-4 flex items-center justify-between transition-colors">
    <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
      Moduł Obliczeniowy
    </span>

    <div class="flex gap-1.5">
      <div class="w-3 h-3 rounded-full bg-slate-200 dark:bg-slate-800"></div>
      <div class="w-3 h-3 rounded-full bg-slate-200 dark:bg-slate-800"></div>
      <div class="w-3 h-3 rounded-full bg-slate-200 dark:bg-slate-800"></div>
    </div>
  </div>

  {/* Główny Kontener Grid: Formularz (Lewo) + Wyniki (Prawo) */}
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 p-6 md:p-8">

    {/* Kolumna Lewa: Pola wejściowe */}
    <div class="lg:col-span-7 flex flex-col gap-6 pr-0 lg:pr-4">

      <div class="border-b border-slate-100 dark:border-slate-800 pb-3 transition-colors">
        <h3 class="text-base font-bold text-slate-900 dark:text-white">Dane wejściowe</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          Wprowadź parametry kosztowe i cenowe produktu.
        </p>
      </div>

      {/* Input: Koszty stałe */}
      <div>
        <label for="bep-fixed-costs" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
          Koszty stałe miesięcznie (PLN)
        </label>
        <div class="group flex items-stretch bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl focus-within:ring-2 focus-within:ring-orange-500 focus-within:border-orange-500 transition-all overflow-hidden">
          <div class="flex items-center justify-center bg-slate-50 dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 px-4 text-slate-400 dark:text-slate-500 transition-colors">
            {/* Ikona sejfu / kosztów stałych */}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
              <path d="M0 4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V6a2 2 0 0 1-2-2z"/>
              <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
            </svg>
          </div>
          <input
            type="number"
            id="bep-fixed-costs"
            placeholder="np. 10000"
            min="0"
            step="0.01"
            class="w-full px-4 py-3 bg-transparent outline-none placeholder-slate-400 text-slate-900 dark:text-white text-sm"
          />
        </div>
      </div>

      {/* Input: Cena jednostkowa */}
      <div>
        <label for="bep-unit-price" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
          Cena sprzedaży jednostkowa netto (PLN)
        </label>
        <div class="group flex items-stretch bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl focus-within:ring-2 focus-within:ring-orange-500 focus-within:border-orange-500 transition-all overflow-hidden">
          <div class="flex items-center justify-center bg-slate-50 dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 px-4 text-slate-400 dark:text-slate-500 transition-colors">
            {/* Ikona tagu z ceną */}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
              <path d="M6 4.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m-1 0a.5.5 0 1 0-1 0 .5.5 0 0 0 1 0"/>
              <path d="M2 1a1 1 0 0 0-1 1v4.586a1 1 0 0 0 .293.707l7 7a1 1 0 0 0 1.414 0l4.585-4.586a1 1 0 0 0 0-1.414l-7-7A1 1 0 0 0 6.586 1zm4 5.586L1.414 2h5.172L13.5 8.914 8.914 13.5z"/>
            </svg>
          </div>
          <input
            type="number"
            id="bep-unit-price"
            placeholder="np. 150"
            min="0"
            step="0.01"
            class="w-full px-4 py-3 bg-transparent outline-none placeholder-slate-400 text-slate-900 dark:text-white text-sm"
          />
        </div>
      </div>

      {/* Input: Koszt zmienny */}
      <div>
        <label for="bep-variable-cost" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
          Koszt zmienny jednostkowy netto (PLN)
        </label>
        <div class="group flex items-stretch bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl focus-within:ring-2 focus-within:ring-orange-500 focus-within:border-orange-500 transition-all overflow-hidden">
          <div class="flex items-center justify-center bg-slate-50 dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 px-4 text-slate-400 dark:text-slate-500 transition-colors">
            {/* Ikona suwaków / kosztów zmiennych */}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
              <path fill-rule="evenodd" d="M11.5 2a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M9.05 3a2.5 2.5 0 0 1 4.9 0H16a.5.5 0 0 1 0 1h-2.05a2.5 2.5 0 0 1-4.9 0H0a.5.5 0 0 1 0-1zM4.5 7a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M2.05 8a2.5 2.5 0 0 1 4.9 0H16a.5.5 0 0 1 0 1H6.95a2.5 2.5 0 0 1-4.9 0H0a.5.5 0 0 1 0-1zm9.5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3m-2.45 1a2.5 2.5 0 0 1 4.9 0H16a.5.5 0 0 1 0 1h-2.05a2.5 2.5 0 0 1-4.9 0H0a.5.5 0 0 1 0-1z"/>
            </svg>
          </div>
          <input
            type="number"
            id="bep-variable-cost"
            placeholder="np. 80"
            min="0"
            step="0.01"
            class="w-full px-4 py-3 bg-transparent outline-none placeholder-slate-400 text-slate-900 dark:text-white text-sm"
          />
        </div>
      </div>

    </div>

    {/* Kolumna Prawa: Warstwa prezentacji wyników (Dashboard) */}
    <div class="lg:col-span-5 bg-slate-50 dark:bg-slate-900/60 rounded-xl p-6 sm:p-8 flex flex-col justify-center gap-6 border border-slate-200 dark:border-slate-800/80 transition-colors">

      <div>
        <p class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1">
          Próg rentowności ilościowy (Wolumen)
        </p>
        <p class="text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight transition-colors" id="bep-units">
          0 szt.
        </p>
      </div>

      <div>
        <p class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1">
          Próg rentowności wartościowy (Przychód)
        </p>
        <p class="text-2xl font-extrabold text-slate-800 dark:text-slate-200 transition-colors" id="bep-revenue">
          0,00 zł
        </p>
      </div>

      <div class="grid grid-cols-2 gap-4 pt-6 border-t border-slate-200 dark:border-slate-800 transition-colors">
        <div>
          <p class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1">
            Marża kontrybucyjna
          </p>
          <p class="text-xl font-extrabold text-emerald-600 dark:text-emerald-400 transition-colors" id="bep-contribution">
            0,00 zł
          </p>
        </div>
        <div>
          <p class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1">
            Wskaźnik marży
          </p>
          <p class="text-xl font-bold text-slate-600 dark:text-slate-400 transition-colors" id="bep-ratio">
            0,00%
          </p>
        </div>
      </div>

    </div>

  </div>
</div>

<script>
  // Logika obliczeniowa z pełnym wsparciem dla View Transitions (island logic)
  const initBepCalculator = () => {
    const fixedInput = document.getElementById('bep-fixed-costs') as HTMLInputElement | null;
    const priceInput = document.getElementById('bep-unit-price') as HTMLInputElement | null;
    const variableInput = document.getElementById('bep-variable-cost') as HTMLInputElement | null;

    const outUnits = document.getElementById('bep-units');
    const outRevenue = document.getElementById('bep-revenue');
    const outContribution = document.getElementById('bep-contribution');
    const outRatio = document.getElementById('bep-ratio');

    const formatCurrency = (value: number) => {
      if (isNaN(value) || !isFinite(value)) return "0,00 zł";
      return new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN' }).format(value);
    };

    const formatNumber = (value: number) => {
      if (isNaN(value) || !isFinite(value)) return "0";
      return new Intl.NumberFormat('pl-PL', { maximumFractionDigits: 0 }).format(value);
    };

    const runCalculation = () => {
      if (!fixedInput || !priceInput || !variableInput) return;

      const fixedCosts = parseFloat(fixedInput.value) || 0;
      const price = parseFloat(priceInput.value) || 0;
      const variableCost = parseFloat(variableInput.value) || 0;

      // Obliczenie marży kontrybucyjnej kwotowej i wskaźnika (procentowej)
      const contribution = price - variableCost;
      const contributionRatio = price > 0 ? (contribution / price) : 0;

      if (outContribution) {
        outContribution.textContent = formatCurrency(contribution);
      }
      if (outRatio) {
        outRatio.textContent = `${(contributionRatio * 100).toFixed(2)}%`;
      }

      // Zabezpieczenie przed dzieleniem przez zero oraz błędnymi konfiguracjami ekonomicznymi
      if (contribution <= 0 || fixedCosts <= 0 || price <= 0) {
        if (outUnits) outUnits.textContent = "0 szt.";
        if (outRevenue) outRevenue.textContent = "0,00 zł";
        return;
      }

      // BEP Ilościowy (zgodnie z teorią finasów: zaokrąglamy w górę do pełnej sztuki)
      const bepUnits = Math.ceil(fixedCosts / contribution);
      
      // BEP Wartościowy wyliczany ze wskaźnika marży kontrybucyjnej lub wolumenu i ceny
      const bepRevenue = bepUnits * price;

      if (outUnits) {
        outUnits.textContent = `${formatNumber(bepUnits)} szt.`;
      }
      if (outRevenue) {
        outRevenue.textContent = formatCurrency(bepRevenue);
      }
    };

    // Rejestracja słuchaczy zdarzeń
    fixedInput?.addEventListener('input', runCalculation);
    priceInput?.addEventListener('input', runCalculation);
    variableInput?.addEventListener('input', runCalculation);
  };

  // Cykl inicjalizacji odporny na odświeżenia stanów SPA i ładowanie tradycyjne
  initBepCalculator();
  document.addEventListener('astro:after-swap', initBepCalculator);
</script>
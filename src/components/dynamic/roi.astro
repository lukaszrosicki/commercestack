---
// src/components/dynamic/roi-calculator.astro
// Integracja warstwy wizualnej kalkulatora ROI ze wsparciem Dark Mode i optymalizacją inline SVG
---

<div class="border border-slate-200 dark:border-slate-800 rounded-2xl bg-white dark:bg-slate-900 shadow-sm overflow-hidden transition-colors duration-200">
  
  {/* Nagłówek kalkulatora (Górna belka systemowa) */}
  <div class="bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 px-6 py-4 flex items-center justify-between transition-colors">
    <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Moduł Obliczeniowy</span>
    
    <div class="flex gap-1.5">
      <div class="w-3 h-3 rounded-full bg-slate-200 dark:bg-slate-800"></div>
      <div class="w-3 h-3 rounded-full bg-slate-200 dark:bg-slate-800"></div>
      <div class="w-3 h-3 rounded-full bg-slate-200 dark:bg-slate-800"></div>
    </div>
  </div>

  {/* Główny Kontener Grid: Formularz (Lewo) + Wyniki (Prawo) */}
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 p-6 md:p-8">
    
    {/* Kolumna Lewa: Pola wejściowe */}
    <div class="lg:col-span-7 flex flex-col gap-6 pr-0 lg:pr-4">
      
      <div class="border-b border-slate-100 dark:border-slate-800 pb-3 transition-colors">
        <h3 class="text-base font-bold text-slate-900 dark:text-white">Dane wejściowe</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Wprowadź koszty i przychody z kampanii marketingowej.</p>
      </div>
      
      {/* Input: Budżet Reklamowy (Ad Spend) */}
      <div>
        <label for="roi-ad-spend" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
          Budżet reklamowy netto / Nakłady (PLN)
        </label>
        <div class="group flex items-stretch bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl focus-within:ring-2 focus-within:ring-orange-500 focus-within:border-orange-500 transition-all overflow-hidden">
          <div class="flex items-center justify-center bg-slate-50 dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 px-4 text-slate-400 dark:text-slate-500 transition-colors">
            {/* Natywna ikona megaphone/ads inline SVG */}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
              <path d="M13 2.5a1.5 1.5 0 0 1 3 0v11a1.5 1.5 0 0 1-3 0v-11zm-1 .75c0 .414-.336.75-.75.75H4.75a.75.75 0 0 1-.75-.75v-1.5A.75.75 0 0 1 4.75 1h6.5c.414 0 .75.336.75.75v1.5zM0 6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6zm11 1.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
            </svg>
          </div>
          <input 
            type="number" 
            id="roi-ad-spend" 
            placeholder="np. 2000" 
            min="0" 
            step="0.01"
            class="w-full px-4 py-3 bg-transparent outline-none placeholder-slate-400 text-slate-900 dark:text-white text-sm" 
          />
        </div>
      </div>

      {/* Input: Przychód z Kampanii */}
      <div>
        <label for="roi-revenue" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
          Przychód ze sprzedaży netto (PLN)
        </label>
        <div class="group flex items-stretch bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl focus-within:ring-2 focus-within:ring-orange-500 focus-within:border-orange-500 transition-all overflow-hidden">
          <div class="flex items-center justify-center bg-slate-50 dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 px-4 text-slate-400 dark:text-slate-500 transition-colors">
            {/* Natywna ikona cart inline SVG */}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
              <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l1.313 7h8.17l1.313-7H3.102zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
            </svg>
          </div>
          <input 
            type="number" 
            id="roi-revenue" 
            placeholder="np. 10000" 
            min="0" 
            step="0.01"
            class="w-full px-4 py-3 bg-transparent outline-none placeholder-slate-400 text-slate-900 dark:text-white text-sm" 
          />
        </div>
      </div>

      {/* Input: Koszt Produktów (COGS) */}
      <div>
        <label for="roi-cogs" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
          Koszt sprzedanych towarów / COGS (PLN) <span class="text-xs font-normal text-slate-400 dark:text-slate-500">(opcjonalnie)</span>
        </label>
        <div class="group flex items-stretch bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl focus-within:ring-2 focus-within:ring-orange-500 focus-within:border-orange-500 transition-all overflow-hidden">
          <div class="flex items-center justify-center bg-slate-50 dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 px-4 text-slate-400 dark:text-slate-500 transition-colors">
            {/* Natywna ikona box/package inline SVG */}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
              <path d="M7.752.066a.5.5 0 0 1 .496 0l3.75 2.143a.5.5 0 0 1 .252.434v3.995l3.498 2A.5.5 0 0 1 16 9.07v4.286a.5.5 0 0 1-.252.434l-3.75 2.143a.5.5 0 0 1-.496 0l-3.502-2-3.502 2a.5.5 0 0 1-.496 0l-3.75-2.143A.5.5 0 0 1 0 13.357V9.071a.5.5 0 0 1 .252-.434L3.75 6.638V2.643a.5.5 0 0 1 .252-.434zM4.25 7.504 1.501 9.075 4.25 10.647l2.749-1.572zm4.5 0 2.749 1.572 2.749-1.572-2.749-1.571zm-.75 4.14-2.75 1.572 2.75 1.572 2.75-1.572zm-4.75.286L1.501 13.5l2.749 1.572zm10.499 1.214 2.749-1.572-2.749-1.571zM8 1.777 5.251 3.349 8 4.92l2.749-1.571zM4.25 4.218 1.501 5.79 4.25 7.361l2.749-1.572zm7.5 0-2.749 1.572 2.749 1.571 2.75-1.571z"/>
            </svg>
          </div>
          <input 
            type="number" 
            id="roi-cogs" 
            placeholder="Wartość zakupowa sprzedanych produktów" 
            min="0" 
            step="0.01"
            class="w-full px-4 py-3 bg-transparent outline-none placeholder-slate-400 text-slate-900 dark:text-white text-sm" 
          />
        </div>
      </div>

    </div>

    {/* Kolumna Prawa: Warstwa prezentacji wyników (Dashboard) */}
    <div class="lg:col-span-5 bg-slate-50 dark:bg-slate-900/60 rounded-xl p-6 sm:p-8 flex flex-col justify-center gap-6 border border-slate-200 dark:border-slate-800/80 transition-colors">
      
      <div>
        <p class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1">Zwrot z inwestycji (ROI)</p>
        <p class="text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight transition-colors" id="roi-res-roi">0%</p>
      </div>
      
      <div>
        <p class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1">Wynik ROAS</p>
        <p class="text-2xl font-extrabold text-slate-800 dark:text-slate-200 transition-colors" id="roi-res-roas">0.00</p>
      </div>
      
      <div class="grid grid-cols-2 gap-4 pt-6 border-t border-slate-200 dark:border-slate-800 transition-colors">
        <div>
          <p class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1">Rzeczywisty Zysk</p>
          <p class="text-xl font-extrabold text-emerald-600 dark:text-emerald-400 transition-colors" id="roi-res-profit">0,00 zł</p>
        </div>
        <div>
          <p class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1">Łączny Koszt</p>
          <p class="text-xl font-bold text-slate-600 dark:text-slate-400 transition-colors" id="roi-res-total-cost">0,00 zł</p>
        </div>
      </div>
      
    </div>
    
  </div>
</div>

<script>
  // Logika obliczeniowa z pełnym wsparciem dla View Transitions (island logic)
  const initRoiCalculator = () => {
    const adSpendInput = document.getElementById('roi-ad-spend') as HTMLInputElement | null;
    const revenueInput = document.getElementById('roi-revenue') as HTMLInputElement | null;
    const cogsInput = document.getElementById('roi-cogs') as HTMLInputElement | null;

    const outRoi = document.getElementById('roi-res-roi');
    const outRoas = document.getElementById('roi-res-roas');
    const outProfit = document.getElementById('roi-res-profit');
    const outTotalCost = document.getElementById('roi-res-total-cost');

    const formatCurrency = (value: number) => {
      if (isNaN(value) || !isFinite(value)) return "0,00 zł";
      return new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN' }).format(value);
    };

    const runCalculation = () => {
      if (!adSpendInput || !revenueInput || !cogsInput) return;

      const adSpend = parseFloat(adSpendInput.value) || 0;
      const revenue = parseFloat(revenueInput.value) || 0;
      const cogs = parseFloat(cogsInput.value) || 0;

      // Obliczenia marketingowe
      const totalCost = adSpend + cogs;
      const netProfit = revenue - totalCost;
      
      // Bezpieczny ROAS (unikamy dzielenia przez zero)
      const roas = adSpend > 0 ? (revenue / adSpend) : 0;
      
      // Bezpieczny ROI (unikamy dzielenia przez zero)
      const roi = totalCost > 0 ? (netProfit / totalCost) * 100 : 0;

      // Aktualizacja DOM z formatowaniem i klasami kolorystycznymi dla ROI
      if (outRoi) {
        outRoi.textContent = `${roi.toFixed(0)}%`;
        if (roi > 0) {
          outRoi.className = "text-4xl font-extrabold text-emerald-600 dark:text-emerald-400 tracking-tight transition-colors";
        } else if (roi < 0) {
          outRoi.className = "text-4xl font-extrabold text-rose-600 dark:text-rose-400 tracking-tight transition-colors";
        } else {
          outRoi.className = "text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight transition-colors";
        }
      }

      if (outRoas) {
        outRoas.textContent = roas.toFixed(2);
      }

      if (outProfit) {
        outProfit.textContent = formatCurrency(netProfit);
        if (netProfit < 0) {
          outProfit.className = "text-xl font-extrabold text-rose-600 dark:text-rose-400 transition-colors";
        } else {
          outProfit.className = "text-xl font-extrabold text-emerald-600 dark:text-emerald-400 transition-colors";
        }
      }

      if (outTotalCost) {
        outTotalCost.textContent = formatCurrency(totalCost);
      }
    };

    // Rejestracja słuchaczy zdarzeń
    adSpendInput?.addEventListener('input', runCalculation);
    revenueInput?.addEventListener('input', runCalculation);
    cogsInput?.addEventListener('input', runCalculation);
  };

  // Cykl inicjalizacji odporny na odświeżenia stanów SPA i ładowanie tradycyjne
  initRoiCalculator();
  document.addEventListener('astro:after-swap', initRoiCalculator);
</script>
---
// src/layouts/Layout.astro
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

// Przeniesienie i adaptacja logiki domyślnych propsów z poprzedniej wersji wizualnej
const { 
  title = 'CStack.eu - Narzędzia i Kalkulatory inżynierskie', 
  description = 'Zbiór specjalistycznych narzędzi deweloperskich, kalkulatorów e-commerce i skryptów analitycznych.' 
} = Astro.props;
---

<!doctype html>
<html lang="pl" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      
      const theme = getThemePreference();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  
  {/* Adaptacja stylów: czyste tło bg-white przechodzące w bg-slate-950 w trybie dark z płynną animacją */}
  <body class="font-sans bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-50 antialiased flex flex-col min-h-screen transition-colors duration-200">
    
    {/* Poprawny technicznie komponent nawigacji zintegrowany z nową architekturą */}
    <Navbar />
    
    {/* Główny kontener grid/flex dla zawartości stron i kalkulatorów */}
    <main class="flex-grow container mx-auto px-4 py-8 max-w-6xl">
      <slot />
    </main>

    <Footer />
  </body>
</html>
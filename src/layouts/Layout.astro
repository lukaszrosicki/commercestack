---
// src/layouts/Layout.astro
import Navbar from '../components/Navbar.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <Navbar /> <main class="container">
      <slot /> </main>
  </body>
</html>

<style is:global>
  /* Globalne style dla całej aplikacji */
  body {
    background: #050505;
    color: #e5e5e5;
    font-family: system-ui, sans-serif;
    margin: 0;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }
</style>
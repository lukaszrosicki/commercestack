---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content'; // Zapewnienie stałego mapowania typów dostarczanych przez astro sync[cite: 1]
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool: CollectionEntry<'tools'>) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

// Eliminacja typu 'never' poprzez jawne określenie struktury propsów wejściowych
interface Props {
  tool: CollectionEntry<'tools'>;
}

const { tool } = Astro.props as Props;
const { Content } = await tool.render();
---
<Layout title={tool.data.title}>
  <h1>Narzędzie: {tool.data.title}</h1>
  <p>Kategoria: {tool.data.category}</p>
  
  <div class="markdown-body">
    <Content />
  </div>

  <div id="dynamic-tool-root"></div>

  {tool.data.scriptPath && (
    <script is:inline data-script={tool.data.scriptPath}>
      const scriptPath = document.currentScript?.getAttribute('data-script');
      if (scriptPath) {
        import(scriptPath)
          .then(module => {
            if (module.init) module.init();
          })
          .catch(err => console.error("Błąd ładowania skryptu narzędzia:", err));
      }
    </script>
  )}
</Layout>
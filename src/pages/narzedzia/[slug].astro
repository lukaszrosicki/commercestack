---
// src/pages/narzedzia/[slug].astro
// Pełna stabilizacja typowania pod mechanizm sprawdzania błędów (astro check) w potoku CI/CD
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Mapowanie komponentów przez warstwę bundlera Vite w czasie kompilacji
const dynamicComponents = import.meta.glob('../../components/dynamic/*.astro');

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool: CollectionEntry<'tools'>) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

// Interfejs wejściowy dla ścisłej kontroli typów Astro
interface Props {
  tool: CollectionEntry<'tools'>;
}

// NAPRAWIONE: Jawne rzutowanie typu (as Props), które definitywnie usuwa błędy typu 'never' na GitHubie
const { tool } = Astro.props as Props;
const { title, category, excelLink, type } = tool.data;

// Renderowanie dokumentacji Markdown
const { Content } = await tool.render();

// Zabezpieczenie ścieżek bazowych pod GitHub Pages i routing lokalny
const base = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

// Dynamiczne generowanie ścieżki do dedykowanego komponentu .astro na podstawie sluga
const componentPath = `../../components/dynamic/${tool.slug}.astro`;
const dynamicComponentLoader = dynamicComponents[componentPath];

// Rezolucja modułu na poziomie serwera
const DynamicComponent = dynamicComponentLoader 
  ? ((await dynamicComponentLoader()) as any).default 
  : null;
---

<Layout title={`${title} - CStack.eu`} description={`Uruchom narzędzie ${title} z kategorii ${category}.`}>
  <div class="py-6 sm:py-10">
    
    {/* Pasek Nawigacyjny Breadcrumbs */}
    <nav aria-label="Breadcrumb" class="flex items-center text-sm font-medium text-slate-500 mb-6 space-x-2 whitespace-nowrap overflow-x-auto">
      <a href={base} class="hover:text-orange-500 transition-colors flex items-center dark:text-slate-400 dark:hover:text-orange-500">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="mr-1.5" viewBox="0 0 16 16">
          <path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L2 8.207V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM13 7.207V13.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V7.207l5-5z"/>
        </svg>
        Strona główna
      </a>
      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="currentColor" class="text-slate-400 shrink-0" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"/>
      </svg>
      
      <a href={`${base}narzedzia`} class="hover:text-orange-500 transition-colors dark:text-slate-400 dark:hover:text-orange-500">
        Narzędzia
      </a>
      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="currentColor" class="text-slate-400 shrink-0" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"/>
      </svg>
      <span class="text-slate-900 dark:text-slate-300 font-semibold truncate max-w-[200px] sm:max-w-none" aria-current="page">{title}</span>
    </nav>
    
    {/* Sekcja Nagłówkowa */}
    <div class="max-w-3xl mb-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4 transition-colors">
        {title}
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 transition-colors">
        Uruchom wyspecjalizowany moduł inżynierski i przejdź bezpośrednio do panelu obliczeniowego.
      </p>
    </div>

    {/* Główna Siatka Dwu-kolumnowa */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8 space-y-12">
        
        {/* Renderowanie Warunkowe Komponentu .astro wyciągniętego z mapy globbingu */}
        {DynamicComponent ? (
          <DynamicComponent />
        ) : (
          <div class="bg-slate-50 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm transition-colors min-h-[350px]">
            <div class="flex flex-col items-center justify-center p-12 text-center min-h-[300px]">
              <div class="p-3 bg-white dark:bg-slate-800 rounded-full shadow-sm mb-4 border dark:border-slate-700">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="text-orange-500 animate-spin" viewBox="0 0 16 16">
                  <path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/>
                </svg>
              </div>
              <p class="text-slate-700 dark:text-slate-300 font-semibold mb-1">Kalkulator w budowie...</p>
              <p class="text-xs text-slate-400">Dedykowany interfejs dla {title} zostanie wkrótce zaimplementowany.</p>
            </div>
          </div>
        )}

        {/* Sekcja Dokumentacji Technicznej */}
        <article class="prose prose-slate dark:prose-invert prose-lg max-w-none prose-headings:font-bold prose-headings:text-slate-900 dark:prose-headings:text-white prose-a:text-orange-500 hover:prose-a:text-orange-600 transition-colors">
          <Content />
        </article>
      </div>

      {/* Kolumna Prawa: Sidebar */}
      <aside class="lg:col-span-4 sticky top-24 space-y-6">
  {/* Główny boks metadanych i zasobów */}
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm transition-colors">
    
    {/* Atrybut: Kategoria */}
    <div class="flex items-center justify-between mb-4 pb-4 border-b border-slate-100 dark:border-slate-800">
      <div class="flex items-center text-sm font-medium text-slate-600 dark:text-slate-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 text-slate-400" viewBox="0 0 24 24">
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
        </svg> 
        Kategoria
      </div>
      <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 rounded-md">
        {category}
      </span>
    </div>

    {/* Atrybut: Typ Narzędzia (Nowe pole) */}
    <div class="flex items-center justify-between mb-4 pb-4 border-b border-slate-100 dark:border-slate-800">
      <div class="flex items-center text-sm font-medium text-slate-600 dark:text-slate-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 text-slate-400" viewBox="0 0 24 24">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
        Typ modułu
      </div>
      <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 rounded-md">
        {type}
      </span>
    </div>
    
    {/* Status Operacyjny (Natywny pulse lekki) */}
    <div class="flex items-center justify-between" class={excelLink ? "mb-6" : ""}>
      <div class="flex items-center text-sm font-medium text-slate-600 dark:text-slate-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 text-slate-400" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>
        </svg> 
        Status operacyjny
      </div>
      <span class="font-semibold text-emerald-600 dark:text-emerald-400 text-sm flex items-center">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
        Gotowy do użycia
      </span>
    </div>
    
    {/* Dynamiczny przycisk pobierania arkusza Excel / Google Sheets */}
    {excelLink && (
      <a 
        href={excelLink} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="mt-6 flex items-center justify-center w-full px-4 py-3 bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 font-semibold rounded-xl hover:bg-emerald-100 dark:hover:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-900 transition-colors text-sm text-center shadow-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" viewBox="0 0 24 24">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
        </svg>
        Pobierz powiązany arkusz
      </a>
    )}
  </div>

  {/* Boks Interakcji B2B / Inżynierskiej (Zamiast newslettera) */}
  <div class="bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-xl p-6 transition-colors">
    <h3 class="font-bold text-slate-900 dark:text-white mb-2 flex items-center text-sm tracking-tight">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 text-slate-400" viewBox="0 0 24 24">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
      Masz pomysł na kalkulator?
    </h3>
    <p class="text-xs text-slate-500 dark:text-slate-400 mb-4 leading-relaxed">
      Potrzebujesz dedykowanego algorytmu, automatyzacji procesów lub nietypowego modułu analitycznego? Skonfigurujmy to razem.
    </p>
    <a 
      href="/kontakt" 
      class="block w-full text-center px-4 py-2.5 bg-slate-900 dark:bg-slate-100 dark:text-slate-950 dark:hover:bg-slate-200 text-white font-semibold rounded-lg hover:bg-slate-800 transition-colors text-xs uppercase tracking-wider shadow-sm"
    >
      Skontaktuj się ze mną
    </a>
  </div>
</aside>
    </div>

  </div>
</Layout>
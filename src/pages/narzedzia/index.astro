---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content'; // Definicja typów zapobiegająca niejawnemu typowaniu 'any'[cite: 1]
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro'; //[cite: 1]

const tools = await getCollection('tools');
// Bezpieczne mapowanie typów wewnątrz konstruktora unikalnych kategorii danych
const categories = [...new Set(tools.map((t: CollectionEntry<'tools'>) => t.data.category))];
---
<Layout title="Narzędzia">
  <h1>Moje Narzędzia</h1>
  
  <div class="filters">
    <button class="filter-btn" data-category="all">Wszystkie</button>
    {categories.map((cat) => (
      <button class="filter-btn" data-category={cat}>{cat}</button>
    ))}
  </div>

  <div class="tools-grid">
    {tools.map((tool: CollectionEntry<'tools'>) => (
      <div class="tool-item-wrapper" data-category={tool.data.category}>
        {/* Usunięto pojedyncze parametry; przekazujemy cały obiekt tool wymagany przez komponent ToolCard[cite: 1] */}
        <ToolCard tool={tool} /> 
      </div>
    ))}
  </div>

  <script>
    const buttons = document.querySelectorAll('.filter-btn');
    const wrappers = document.querySelectorAll('.tool-item-wrapper') as NodeListOf<HTMLElement>;

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');
        wrappers.forEach(wrapper => {
          if (cat === 'all' || wrapper.getAttribute('data-category') === cat) {
            wrapper.style.display = 'block';
          } else {
            wrapper.style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>

<style>
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
</style>
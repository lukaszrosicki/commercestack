---
// src/pages/narzedzia/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro'; // Import komponentu

const tools = await getCollection('tools');
const categories = [...new Set(tools.map(t => t.data.category))];
---
<Layout title="Narzędzia">
  <h1>Moje Narzędzia</h1>
  
  <div class="filters">
    <button class="filter-btn" data-category="all">Wszystkie</button>
    {categories.map(cat => (
      <button class="filter-btn" data-category={cat}>{cat}</button>
    ))}
  </div>

  <div class="tools-grid">
    {tools.map(tool => (
      <div class="tool-item-wrapper" data-category={tool.data.category}>
        <ToolCard 
          title={tool.data.title} 
          category={tool.data.category} 
          slug={tool.slug} 
        />
      </div>
    ))}
  </div>

  <script>
    const buttons = document.querySelectorAll('.filter-btn');
    const wrappers = document.querySelectorAll('.tool-item-wrapper') as NodeListOf<HTMLElement>;

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');
        wrappers.forEach(wrapper => {
          if (cat === 'all' || wrapper.getAttribute('data-category') === cat) {
            wrapper.style.display = 'block';
          } else {
            wrapper.style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>

<style>
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
</style>
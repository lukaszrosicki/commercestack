---
// src/pages/narzedzia/index.astro
// Architektura z lewym panelem filtrów (Sidebar), wyszukiwarką i obsługą Dark Mode
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';

// Pobieramy dane z prawidłowej kolekcji narzędzi
const tools = await getCollection('tools');

// Generowanie obiektów prototypowych (mock) dla zachowania spójności makiety wizualnej
const mockTools = Array.from({ length: 12 }, (_, index) => {
  const baseTool = tools[index % tools.length] || {
    id: `test-${index}`,
    slug: `mock-slug-${index}`,
    data: {
      title: `Przykładowe Narzędzie ${index + 1}`,
      category: "DSP",
    }
  };

  return {
    ...baseTool,
    slug: index < tools.length ? baseTool.slug : `${baseTool.slug}-${index}`,
    data: {
      ...baseTool.data,
      title: index < tools.length ? baseTool.data.title : `Przykładowe Narzędzie ${index + 1}`
    }
  };
});

// Dynamiczne pobieranie unikalnych kategorii (Single Source of Truth)
const categories = [...new Set(mockTools.map(t => t.data.category.toLowerCase()))];
---

<Layout title="Narzędzia i Kalkulatory - CStack.eu">
  <div class="py-6 sm:py-10">
    
    {/* Sekcja Nagłówkowa (Hero) */}
    <section class="mb-12 border-b border-slate-100 dark:border-slate-800 pb-8 transition-colors">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-3 transition-colors">
        Centrum Narzędzi <span class="text-orange-500">Inżynierskich</span>.
      </h1>
      <p class="text-base text-slate-600 dark:text-slate-400 max-w-3xl transition-colors">
        Zbiór darmowych, minimalistycznych modułów obliczeniowych pomagających w analizie sygnałów, przetwarzaniu danych oraz optymalizacji procesów systemowych.
      </p>
    </section>

    {/* Dwukolumnowy Układ Główny: Sidebar (Lewo) + Kontent (Prawo) */}
    <div class="flex flex-col md:flex-row gap-8 items-start">
      
      {/* LEWY PANEL (Sidebar) - Filtry Kategorii */}
      <aside class="w-full md:w-64 shrink-0 bg-slate-50/50 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 sticky top-24 transition-all">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-4">
          Filtruj według kategorii
        </h2>
        
        <div class="flex flex-row flex-wrap md:flex-col gap-1.5 filters">
          <button 
            data-category="wszystko" 
            class="filter-btn w-auto md:w-full text-left px-4 py-2.5 rounded-xl text-sm font-medium transition-all bg-slate-900 text-white hover:bg-slate-800 border border-transparent dark:bg-slate-100 dark:text-slate-950 dark:hover:bg-slate-200 shadow-sm"
          >
            Wszystkie narzędzia
          </button>
          
          {categories.map(cat => (
            <button 
              data-category={cat} 
              class="filter-btn w-auto md:w-full text-left px-4 py-2.5 rounded-xl text-sm font-medium transition-all bg-white border border-slate-200 text-slate-600 hover:border-slate-300 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200"
            >
              <span class="inline-block w-2 h-2 rounded-full bg-slate-300 dark:bg-slate-700 mr-2 group-active:bg-orange-500"></span>
              {cat.toUpperCase()}
            </button>
          ))}
        </div>
      </aside>

      {/* PRAWY PANEL - Wyszukiwarka i Siatka Kart */}
      <div class="grow w-full">
        
        {/* Wyszukiwarka tekstowa */}
        <div class="relative group mb-8">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="text-slate-400 group-focus-within:text-orange-500 transition-colors" viewBox="0 0 16 16">
              <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
            </svg>
          </div>
          <input 
            id="search-input"
            type="text" 
            placeholder="Wpisz frazę aby przefiltrować w czasie rzeczywistym... np. generator" 
            class="block w-full pl-12 pr-4 py-3.5 bg-white border border-slate-200 dark:bg-slate-900 dark:border-slate-800 rounded-2xl leading-5 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-4 focus:ring-orange-500/10 focus:border-orange-500 sm:text-sm transition-all shadow-sm"
          />
        </div>

        {/* Siatka komponentów ToolCard */}
        <section class="tools-grid">
          {mockTools.map((tool) => (
            <div 
              class="tool-item-wrapper h-full transition-all duration-200" 
              data-category={tool.data.category?.toLowerCase()} 
              data-title={tool.data.title?.toLowerCase()}
            >
              <ToolCard 
                title={tool.data.title}
                category={tool.data.category}
                slug={tool.slug} 
              />
            </div>
          ))}
        </section>

      </div>
    </div>

  </div>
</Layout>

<script>
  // Dynamiczna mechanika filtracji (Client-Side Hydration)
  const initLayoutControls = () => {
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll('.filter-btn');
    const toolWrappers = document.querySelectorAll('.tool-item-wrapper') as NodeListOf<HTMLElement>;

    let currentCategory = 'wszystko';

    const executeFiltering = () => {
      const searchTerm = searchInput ? searchInput.value.toLowerCase() : '';
      
      toolWrappers.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const category = card.getAttribute('data-category') || '';
        
        const matchesSearch = title.includes(searchTerm);
        const matchesCategory = currentCategory === 'wszystko' || category === currentCategory;
        
        if (matchesSearch && matchesCategory) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    };

    if (searchInput) {
      searchInput.addEventListener('input', executeFiltering);
    }

    // Klasy stanów aktywności dopasowane do Sidebar (wyrównanie do lewej strony)
    const activeClasses = ['bg-slate-900', 'text-white', 'hover:bg-slate-800', 'border-transparent', 'dark:bg-slate-100', 'dark:text-slate-950', 'dark:hover:bg-slate-200', 'shadow-sm'];
    const inactiveClasses = ['bg-white', 'border-slate-200', 'text-slate-600', 'hover:border-slate-300', 'hover:bg-slate-50', 'dark:bg-slate-900', 'dark:border-slate-800', 'dark:text-slate-400', 'dark:hover:bg-slate-800', 'dark:hover:text-slate-200'];

    filterButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        filterButtons.forEach(b => {
          b.classList.remove(...activeClasses);
          b.classList.add(...inactiveClasses);
        });
        
        const target = e.currentTarget as HTMLButtonElement;
        target.classList.remove(...inactiveClasses);
        target.classList.add(...activeClasses);
        
        currentCategory = target.getAttribute('data-category') || 'wszystko';
        executeFiltering();
      });
    });
  };

  // Obsługa cyklu życia skryptu na potrzeby ładowania tradycyjnego i SPA
  initLayoutControls();
  document.addEventListener("astro:after-swap", initLayoutControls);
</script>

<style>
  {/* Responsywna, elastyczna siatka kart */}
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
</style>
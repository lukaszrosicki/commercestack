---
// src/pages/kontakt.astro
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

// Pobieramy treść z pliku Markdown
const page = await getEntry('pages', 'kontakt');
const { Content } = await page.render();
---

<Layout title={`${page.data.title} - CommerceStack`}>
  <div class="py-10 max-w-4xl mx-auto px-4 sm:px-6">
    
    {/* Nagłówek strony */}
    <div class="border-b border-slate-100 dark:border-slate-800 pb-6 mb-8 transition-colors">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">
        {page.data.title}
      </h1>
      <p class="text-base text-slate-500 dark:text-slate-400">
        {page.data.description}
      </p>
    </div>

    {/* Dwukolumnowy układ: Treść (Lewo) + Boxy kontaktu (Prawo) */}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start">
      
      {/* Kolumna Lewa: Treść z Markdowna */}
      <div class="md:col-span-7 prose dark:prose-invert text-slate-600 dark:text-slate-300 text-sm leading-relaxed space-y-4">
        <Content />
      </div>

      {/* Kolumna Prawa: Karty Bezpośredniego Kontaktu */}
      <div class="md:col-span-5 space-y-4">
        
        {/* Karta LinkedIn */}
        <a 
          href="https://linkedin.com/in/lukaszrosicki" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="flex items-center gap-4 p-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl hover:border-blue-500 dark:hover:border-blue-500/50 shadow-sm transition-all group"
        >
          <div class="p-3 bg-slate-50 dark:bg-slate-950 text-slate-400 group-hover:text-[#0077B5] dark:group-hover:text-[#0077B5] border border-slate-100 dark:border-slate-800 rounded-lg transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
              <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.426 2.4 4.134c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"/>
            </svg>
          </div>
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Profil Zawodowy</h4>
            <p class="text-sm font-semibold text-slate-900 dark:text-white group-hover:text-[#0077B5] transition-colors">linkedin.com/in/lukaszrosicki</p>
          </div>
        </a>

        {/* Karta E-mail (Zaimplementowany kontener na wstrzyknięcie adresu) */}
        <div 
          id="email-card-container"
          class="flex items-center gap-4 p-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm transition-all group"
        >
          <div class="p-3 bg-slate-50 dark:bg-slate-950 text-slate-400 group-hover:text-orange-500 dark:group-hover:text-orange-400 border border-slate-100 dark:border-slate-800 rounded-lg transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div class="grow">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Adres E-mail</h4>
            {/* Ten element zostanie podmieniony w runtime przez JavaScript */}
            <div id="email-placeholder" class="text-sm font-semibold text-slate-400 dark:text-slate-500 italic animate-pulse">
              Dekodowanie zabezpieczeń...
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</Layout>

<script>
  const injectSecureEmail = () => {
    const container = document.getElementById('email-card-container');
    const placeholder = document.getElementById('email-placeholder');
    
    if (!container || !placeholder) return;

    // Twój adres e-mail zakodowany w Base64.
    // Zakładając adres: kontakt@cstack.eu -> w Base64 to: a29udGFrdEBjc3RhY2suZXU=
    // Zmień poniższy ciąg na Twój realny adres zakodowany w b64 (użyj np. btoa() w konsoli)
    const encodedEmail = "a29udGFrdEBsdWthc3pyb3NpY2tpLnBs"; 
    const decodedEmail = atob(encodedEmail);

    // Budujemy dynamicznie pełnoprawny, klikalny link <a>
    const secureLink = document.createElement('a');
    secureLink.href = `mailto:${decodedEmail}`;
    secureLink.className = "text-sm font-semibold text-slate-900 dark:text-white group-hover:text-orange-500 dark:group-hover:text-orange-400 transition-colors";
    secureLink.textContent = decodedEmail;

    // Podmieniamy stan: wywalamy placeholder z pulsem i wstrzykujemy link
    placeholder.replaceWith(secureLink);

    // Sprawiamy, że cała karta staje się klikalna (podobnie jak ToolCard)
    container.classList.add('cursor-pointer', 'hover:border-orange-500', 'dark:hover:border-orange-500/50');
    container.addEventListener('click', (e) => {
      // Zapobiegamy podwójnemu otwarciu, jeśli użytkownik kliknie bezpośrednio w tekstowy link
      if (e.target !== secureLink) {
        window.location.href = `mailto:${decodedEmail}`;
      }
    });
  };

  // Bezpieczna hydracja na starcie i po przejściach widoków Astro SPA
  injectSecureEmail();
  document.addEventListener('astro:after-swap', injectSecureEmail);
</script>
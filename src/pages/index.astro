---
// src/pages/index.astro
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';

const tools: CollectionEntry<'tools'>[] = await getCollection('tools');

const categories = [
  ...new Set(
    tools
      .map((t: CollectionEntry<'tools'>) => t.data.category?.toLowerCase())
      .filter((cat): cat is string => typeof cat === 'string')
  )
];
---

<Layout title="CommerceStack - Darmowe Narzędzia dla E-commerce" description="Zbiór specjalistycznych narzędzi deweloperskich, kalkulatorów, skilli i narzedzi dla e-commerce.">
  <div class="py-12 sm:py-16">
    
    {/* Sekcja Hero */}
    <section class="text-center max-w-3xl mx-auto mb-16">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-6 transition-colors">
        Zoptymalizuj swój <span class="text-orange-500">workflow</span>.
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed transition-colors">
        Zbiór darmowych, minimalistycznych narzędzi inżynierskich, kalkulatorów systemowych oraz skryptów analitycznych ułatwiających przetwarzanie danych i modelowanie.
      </p>
    </section>

    {/* Sekcja Kontrolna - Wyszukiwarka i Filtry */}
    <section class="max-w-2xl mx-auto mb-16 px-2">
      <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="text-slate-400 group-focus-within:text-orange-500 transition-colors" viewBox="0 0 16 16">
            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
          </svg>
        </div>
        <input 
          id="search-input"
          type="text" 
          placeholder="Znajdź narzędzie... np. kalkulator marży" 
          class="block w-full pl-12 pr-4 py-4 bg-white border border-slate-200 dark:bg-slate-900 dark:border-slate-800 rounded-2xl leading-5 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-4 focus:ring-orange-500/10 focus:border-orange-500 sm:text-sm transition-all shadow-sm"
        />
      </div>
      
      {/* Kontenery filtrów z reaktywnym mapowaniem stylów */}
      <div class="flex flex-wrap justify-center gap-2.5 mt-6">
        <button 
          data-category="wszystko" 
          class="filter-btn px-5 py-2 rounded-full text-sm font-medium transition-colors bg-slate-900 text-white hover:bg-slate-800 border border-transparent dark:bg-slate-100 dark:text-slate-950 dark:hover:bg-slate-200 shadow-sm"
        >
          Wszystko
        </button>
        {categories.map(cat => (
          <button 
            data-category={cat} 
            class="filter-btn px-5 py-2 rounded-full text-sm font-medium transition-colors bg-white border border-slate-200 text-slate-600 hover:border-slate-300 hover:bg-slate-50 dark:bg-slate-900 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-slate-800"
          >
            {cat.toUpperCase()}
          </button>
        ))}
      </div>
    </section>

    {/* Siatka Kart - Zabezpieczona kontenerem CSS Grid */}
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto px-4">
      {tools.map((tool: CollectionEntry<'tools'>) => (
        <div 
          class="tool-item-wrapper h-full transition-all duration-200" 
          data-category={tool.data.category?.toLowerCase()} 
          data-title={tool.data.title?.toLowerCase()}
        >
          <ToolCard 
            title={tool.data.title}
            category={tool.data.category}
            type={tool.data.type}
            shortdesc={tool.data.shortdesc}
            slug={tool.slug}
          />
        </div>
      ))}
    </section>

  </div>
</Layout>

<script>
  // Logika filtracji działająca w warstwie klienta (Client-Side Hydration)
  const initFiltering = () => {
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll('.filter-btn');
    
    // NAPRAWIONE: Zmiana selektora z '.tool-card-wrapper' na '.tool-item-wrapper'
    const toolCards = document.querySelectorAll('.tool-item-wrapper') as NodeListOf<HTMLElement>;

    let currentCategory = 'wszystko';

    const filterCards = () => {
      const searchTerm = searchInput ? searchInput.value.toLowerCase() : '';
      
      toolCards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const category = card.getAttribute('data-category') || '';
        
        const matchesSearch = title.includes(searchTerm);
        const matchesCategory = currentCategory === 'wszystko' || category === currentCategory;
        
        if (matchesSearch && matchesCategory) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    };

    if (searchInput) {
      searchInput.addEventListener('input', filterCards);
    }

    const activeClasses = ['bg-slate-900', 'text-white', 'hover:bg-slate-800', 'border-transparent', 'dark:bg-slate-100', 'dark:text-slate-950', 'dark:hover:bg-slate-200', 'shadow-sm'];
    const inactiveClasses = ['bg-white', 'border-slate-200', 'text-slate-600', 'hover:border-slate-300', 'hover:bg-slate-50', 'dark:bg-slate-900', 'dark:border-slate-800', 'dark:text-slate-300', 'dark:hover:bg-slate-800'];

    filterButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        filterButtons.forEach(b => {
          b.classList.remove(...activeClasses);
          b.classList.add(...inactiveClasses);
        });
        
        const target = e.currentTarget as HTMLButtonElement;
        target.classList.remove(...inactiveClasses);
        target.classList.add(...activeClasses);
        
        currentCategory = target.getAttribute('data-category') || 'wszystko';
        filterCards();
      });
    });
  };

  // Bezpieczne uruchomienie dla tradycyjnego przeładowania oraz Astro View Transitions
  initFiltering();
  document.addEventListener("astro:after-swap", initFiltering);
</script>